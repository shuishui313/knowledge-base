---
import { loadTracks } from '../lib/content'
import { sitePath, type TrackId } from '../lib/paths'

interface Props {
  current: 'home' | 'notes' | TrackId
}

const { current } = Astro.props
const tracks = loadTracks()
const home = sitePath('/')
const notes = sitePath('/notes')
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="wordmark" href={home} aria-current={current === 'home' ? 'page' : undefined}>前线课</a>
    <nav class="nav-links" aria-label="路径">
      {
        tracks.map((track) => (
          <a href={track.href} aria-current={current === track.id ? 'page' : undefined}>
            {track.navLabel}
          </a>
        ))
      }
      <a href={notes} aria-current={current === 'notes' ? 'page' : undefined}>笔记</a>
    </nav>
  </div>
</header>
