---
import '../styles/global.css'
import '@fontsource-variable/inter/index.css'
import 'katex/dist/katex.min.css'
import Seo from '../components/Seo.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { allLessons } from '../lib/content'
import type { TrackId } from '../lib/paths'

interface Props {
  title: string
  description: string
  path: string
  current: 'home' | 'notes' | TrackId
  ogType?: 'website' | 'article'
  robots?: string
  lessonSerial?: string
}

const { title, description, path, current, ogType, robots, lessonSerial } = Astro.props
const order = allLessons().map((lesson) => lesson.serial).join(' ')
const fontHref = 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&display=swap'
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0d10" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <Seo title={title} description={description} path={path} ogType={ogType} robots={robots} />
    <slot name="head" />
  </head>
  <body data-order={order} data-base={import.meta.env.BASE_URL} data-lesson={lessonSerial || undefined}>
    <a class="skip" href="#content">跳到正文</a>
    <Nav current={current} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { boot } from '../scripts/study'
      boot()
    </script>
  </body>
</html>
